            { r: 1, c: 0, type: 'M', initRot: 1, solRot: 0 },
            { r: 1, c: 2, type: 'P', pair: 'A' },
            { r: 4, c: 3, type: 'P', pair: 'A' },
            { r: 4, c: 4, type: 'S', initRot: 1, solRot: 0 },
            { r: 4, c: 5, type: 'T', color: 'cyan' },
            { r: 2, c: 4, type: 'T', color: 'cyan' },
            { r: 1, c: 4, type: 'M', initRot: 0, solRot: 1 },
            { r: 1, c: 3, type: 'T', color: 'cyan' },
            { r: 2, c: 2, type: 'W' }, { r: 3, c: 2, type: 'W' }, { r: 3, c: 3, type: 'W' }
          ]
        },
        {
          id: 9, name: 'Color Shift', size: 6,
          tip: 'Color filters transform any beam into a new color to match colored gems.',
