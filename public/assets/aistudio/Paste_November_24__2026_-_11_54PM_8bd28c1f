      // --- Game State ---
      let state = {
        mode: 'campaign', // 'campaign' | 'endless'
        levelIndex: 0,
        endlessCount: 0,
        size: 5,
        name: '',
        tip: '',
        grid: [],        // 2D array of tile objects or null
        rotatables: [],  // list of rotatable tile refs
        par: 2,
        moves: 0,
        undoStack: [],
        beams: [],
        litTargets: new Set(),
        totalTargets: 0,
        won: false,
