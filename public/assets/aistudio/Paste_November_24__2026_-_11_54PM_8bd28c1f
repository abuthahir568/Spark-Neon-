<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Prism Spark — Neon Laser Puzzle</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Orbitron:wght@600;800&display=swap');
    :root {
      --bg-deep: #070b18;
      --panel-bg: rgba(15, 23, 42, 0.78);
      --border-glow: rgba(56, 189, 248, 0.25);
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background: radial-gradient(circle at 50% 0%, #131d3b 0%, #070b18 65%, #040711 100%);
      color: #f1f5f9;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      overflow-x: hidden;
      touch-action: manipulation;
    }
    .font-display { font-family: 'Orbitron', 'Inter', sans-serif; }
    .glass {
      background: var(--panel-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border-glow);
    }
    .btn-tap {
      transition: transform 0.12s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    }
    .btn-tap:active { transform: scale(0.94); }
    #board-wrap {
      width: 100%;
      max-width: 480px;
      aspect-ratio: 1 / 1;
      position: relative;
      margin: 0 auto;
    }
    canvas#gameCanvas {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 18px;
      box-shadow: 0 0 32px rgba(0, 240, 255, 0.12), inset 0 0 20px rgba(0, 0, 0, 0.6);
      cursor: pointer;
      touch-action: none;
    }
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.92) translateY(8px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-pop { animation: popIn 0.22s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  </style>
</head>
<body class="flex flex-col items-center justify-between min-h-screen px-3 py-3 sm:py-5 select-none">

  <!-- Top Header & HUD -->
  <header class="w-full max-w-[480px] flex flex-col gap-2.5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-fuchsia-500 flex items-center justify-center shadow-lg shadow-cyan-500/25">
          <svg class="w-5 h-5 text-slate-950" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h1 class="font-display text-base sm:text-lg font-extrabold tracking-wider bg-gradient-to-r from-cyan-300 via-sky-200 to-fuchsia-300 bg-clip-text text-transparent leading-none">
            PRISM SPARK
          </h1>
          <p id="levelSubtitle" class="text-[11px] text-slate-400 font-medium mt-0.5">Level 1 • First Spark</p>
        </div>
      </div>

      <div class="flex items-center gap-1.5">
        <button id="btnLevels" type="button" title="Select Level" class="btn-tap glass px-2.5 py-1.5 rounded-xl text-xs font-semibold text-cyan-200 hover:bg-slate-800/80 flex items-center gap-1">
          <span>Levels</span>
          <span id="totalStarsBadge" class="text-amber-400 font-bold">★ 0</span>
        </button>
        <button id="btnSound" type="button" title="Toggle Sound" aria-label="Toggle Sound" class="btn-tap glass w-9 h-9 rounded-xl flex items-center justify-center text-slate-200 hover:bg-slate-800/80">
          <svg id="iconSoundOn" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          </svg>
          <svg id="iconSoundOff" class="w-4 h-4 hidden text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
          </svg>
        </button>
        <button id="btnHelp" type="button" title="How to Play" aria-label="How to Play" class="btn-tap glass w-9 h-9 rounded-xl flex items-center justify-center text-slate-200 hover:bg-slate-800/80 font-bold text-sm">
          ?
        </button>
      </div>
    </div>

    <!-- Stats Strip -->
    <div class="glass rounded-2xl px-3.5 py-2 flex items-center justify-between text-xs">
      <div class="flex items-center gap-3">
        <div>
          <span class="text-slate-400 uppercase tracking-wider text-[10px] block">Moves</span>
          <span id="movesDisplay" class="font-display font-bold text-sm text-white">0</span>
          <span id="parDisplay" class="text-slate-400 text-[11px]">/ 2 par</span>
        </div>
        <div class="h-6 w-px bg-slate-700/70"></div>
        <div>
          <span class="text-slate-400 uppercase tracking-wider text-[10px] block">Gems Lit</span>
          <span id="gemsDisplay" class="font-display font-bold text-sm text-emerald-400">0 / 1</span>
        </div>
      </div>
      <div class="flex items-center gap-1" id="starPreview" aria-label="Current star rating">
        <span class="text-amber-400 text-base">★</span>
        <span class="text-amber-400 text-base">★</span>
        <span class="text-amber-400 text-base">★</span>
      </div>
    </div>
  </header>

  <!-- Main Game Board -->
  <main class="w-full flex flex-col items-center my-2.5 flex-1 justify-center">
    <div id="board-wrap">
      <canvas id="gameCanvas" aria-label="Prism Spark puzzle grid"></canvas>
      <!-- Toast Banner -->
      <div id="toastMsg" class="pointer-events-none opacity-0 transition-opacity duration-300 absolute top-3 left-1/2 -translate-x-1/2 glass px-3.5 py-1.5 rounded-full text-xs font-semibold text-cyan-200 whitespace-nowrap shadow-lg">
        Tap glowing mirrors to rotate!
      </div>
    </div>
    <p id="tipLine" class="mt-2 text-[11px] sm:text-xs text-slate-400 text-center max-w-[440px] px-2">
      Tap any mirror to rotate it and guide the laser beam into every crystal gem.
    </p>
  </main>

  <!-- Bottom Controls -->
  <footer class="w-full max-w-[480px] flex flex-col gap-2">
    <div class="grid grid-cols-4 gap-2">
      <button id="btnUndo" type="button" class="btn-tap glass py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 text-slate-200 hover:bg-slate-800/80 disabled:opacity-40">
        <svg class="w-4 h-4 text-sky-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
        </svg>
        <span class="text-[11px] font-semibold">Undo</span>
      </button>
      <button id="btnReset" type="button" class="btn-tap glass py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 text-slate-200 hover:bg-slate-800/80">
        <svg class="w-4 h-4 text-rose-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="text-[11px] font-semibold">Reset</span>
      </button>
      <button id="btnHint" type="button" class="btn-tap glass py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 text-slate-200 hover:bg-slate-800/80">
        <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        <span class="text-[11px] font-semibold">Hint</span>
      </button>
      <button id="btnEndless" type="button" class="btn-tap bg-gradient-to-br from-fuchsia-600/80 to-indigo-600/80 border border-fuchsia-400/40 py-2.5 rounded-xl flex flex-col items-center justify-center gap-0.5 text-white hover:brightness-110">
        <svg class="w-4 h-4 text-fuchsia-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span class="text-[11px] font-semibold">Endless</span>
      </button>
    </div>
  </footer>

  <!-- Victory Modal -->
  <div id="winModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="modal-pop glass w-full max-w-sm rounded-3xl p-6 text-center shadow-2xl border border-cyan-400/30">
      <div class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-1">Circuit Complete</div>
      <h2 id="winTitle" class="font-display text-2xl font-extrabold text-white mb-2">Level 1 Cleared!</h2>
      <div id="winStars" class="text-4xl tracking-widest my-3 text-amber-400 drop-shadow">★★★</div>
      <p id="winStats" class="text-sm text-slate-300 mb-5">Solved in 2 moves (Par 2)</p>
      <div class="flex gap-2.5">
        <button id="btnWinReplay" type="button" class="btn-tap flex-1 glass py-3 rounded-xl font-semibold text-sm text-slate-200 hover:bg-slate-800/80">
          Replay
        </button>
        <button id="btnWinNext" type="button" class="btn-tap flex-[1.5] bg-gradient-to-r from-cyan-500 to-blue-500 py-3 rounded-xl font-bold text-sm text-slate-950 shadow-lg shadow-cyan-500/30 hover:brightness-110">
          Next Level →
        </button>
      </div>
    </div>
  </div>

  <!-- Level Select Modal -->
  <div id="levelsModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="modal-pop glass w-full max-w-md rounded-3xl p-5 shadow-2xl border border-cyan-400/30 max-h-[85vh] flex flex-col">
      <div class="flex items-center justify-between mb-2.5">
        <div>
          <h2 class="font-display text-lg font-bold text-white">Select Level</h2>
          <p id="levelsProgressText" class="text-xs text-slate-400">1,000 levels • 0 / 3,000 ★</p>
        </div>
        <button id="btnCloseLevels" type="button" class="btn-tap w-8 h-8 rounded-lg glass flex items-center justify-center text-slate-300 hover:text-white">✕</button>
      </div>
      <div class="flex items-center gap-1.5 mb-2.5">
        <button id="btnPagePrev" type="button" class="btn-tap glass px-2.5 py-1.5 rounded-lg text-xs font-bold text-cyan-300 hover:bg-slate-800/80">‹</button>
        <span id="levelsPageLabel" class="flex-1 text-center text-xs font-semibold text-slate-200">Levels 1 – 50</span>
        <button id="btnPageNext" type="button" class="btn-tap glass px-2.5 py-1.5 rounded-lg text-xs font-bold text-cyan-300 hover:bg-slate-800/80">›</button>
        <input id="jumpLevelInput" type="number" min="1" max="1000" placeholder="#" aria-label="Jump to level" class="w-16 bg-slate-900/90 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white text-center focus:outline-none focus:border-cyan-400" />
        <button id="btnJumpLevel" type="button" class="btn-tap bg-cyan-500/20 border border-cyan-400/50 px-2.5 py-1.5 rounded-lg text-xs font-bold text-cyan-200 hover:bg-cyan-500/30">Go</button>
      </div>
      <div id="levelsGrid" class="grid grid-cols-5 gap-2 overflow-y-auto pr-1 py-1"></div>
      <button id="btnModalEndless" type="button" class="btn-tap mt-4 w-full py-2.5 rounded-xl bg-gradient-to-r from-fuchsia-600 to-indigo-600 font-bold text-xs text-white tracking-wide">
        Play Random Endless Puzzle
      </button>
    </div>
  </div>

  <!-- Help Modal -->
  <div id="helpModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="modal-pop glass w-full max-w-sm rounded-3xl p-5 shadow-2xl border border-cyan-400/30">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-display text-lg font-bold text-white">How to Play</h2>
        <button id="btnCloseHelp" type="button" class="btn-tap w-8 h-8 rounded-lg glass flex items-center justify-center text-slate-300 hover:text-white">✕</button>
      </div>
      <ul class="space-y-2.5 text-xs text-slate-300 leading-relaxed">
        <li class="flex gap-2.5 items-start">
          <span class="w-6 h-6 rounded-md bg-cyan-500/20 border border-cyan-400/50 text-cyan-300 font-bold flex items-center justify-center shrink-0">/</span>
          <span><strong class="text-white">Mirrors:</strong> Tap to rotate 90° and bounce the laser beam around walls.</span>
        </li>
        <li class="flex gap-2.5 items-start">
          <span class="w-6 h-6 rounded-md bg-amber-500/20 border border-amber-400/50 text-amber-300 font-bold flex items-center justify-center shrink-0">❖</span>
          <span><strong class="text-white">Splitters:</strong> Beam passes straight through AND splits 90° at the same time. Tap to rotate.</span>
        </li>
        <li class="flex gap-2.5 items-start">
          <span class="w-6 h-6 rounded-md bg-fuchsia-500/20 border border-fuchsia-400/50 text-fuchsia-300 font-bold flex items-center justify-center shrink-0">◎</span>
          <span><strong class="text-white">Portals:</strong> Beams entering one portal warp out of its matching pair in the same direction.</span>
        </li>
        <li class="flex gap-2.5 items-start">
          <span class="w-6 h-6 rounded-md bg-emerald-500/20 border border-emerald-400/50 text-emerald-300 font-bold flex items-center justify-center shrink-0">◈</span>
          <span><strong class="text-white">Color Filters &amp; Gems:</strong> Filters recolor beams. Light up every crystal gem with its matching color to win!</span>
        </li>
      </ul>
      <p class="mt-3 text-[11px] text-slate-400">Desktop tip: Use Arrow keys + Space to play, R to reset, H for hint.</p>
      <button id="btnHelpGotIt" type="button" class="btn-tap mt-4 w-full py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-bold text-sm">
        Got It!
      </button>
    </div>
  </div>

  <script>
    (function () {
      'use strict';

      // --- Color Palette ---
      const COLORS = {
        cyan:    { main: '#00f0ff', glow: 'rgba(0, 240, 255, 0.55)', soft: '#67e8f9' },
        magenta: { main: '#ff2a85', glow: 'rgba(255, 42, 133, 0.55)', soft: '#f9a8d4' },
        gold:    { main: '#ffbe0b', glow: 'rgba(255, 190, 11, 0.55)', soft: '#fde047' }
      };

      // Directions: 0=Up, 1=Right, 2=Down, 3=Left
      const DR = [-1, 0, 1, 0];
      const DC = [0, 1, 0, -1];

      // --- 12 Handcrafted, Mathematically Verified Levels ---
      // tile types: E (emitter), T (target), M (mirror), S (splitter), W (wall), P (portal), F (filter)
      const LEVELS = [
        {
          id: 1, name: 'First Spark', size: 5,
          tip: 'Tap the glowing mirrors to bounce the cyan laser into the gem.',
          tiles: [
            { r: 2, c: 0, type: 'E', dir: 1, color: 'cyan' },
            { r: 2, c: 3, type: 'M', initRot: 0, solRot: 1 },
            { r: 4, c: 3, type: 'M', initRot: 1, solRot: 0 },
            { r: 4, c: 1, type: 'T', color: 'cyan' }
          ]
        },
        {
          id: 2, name: 'Zig Zag', size: 5,
          tip: 'Beams pass straight through gems so you can chain multiple gems together.',
          tiles: [
            { r: 0, c: 0, type: 'E', dir: 1, color: 'cyan' },
            { r: 0, c: 4, type: 'M', initRot: 0, solRot: 1 },
            { r: 2, c: 4, type: 'M', initRot: 1, solRot: 0 },
            { r: 2, c: 2, type: 'T', color: 'cyan' },
            { r: 2, c: 1, type: 'M', initRot: 1, solRot: 0 },
            { r: 4, c: 1, type: 'T', color: 'cyan' },
            { r: 1, c: 2, type: 'W' },
            { r: 3, c: 3, type: 'W' }
          ]
        },
        {
          id: 3, name: 'The Vault', size: 5,
          tip: 'Route the gold beam all the way around the obsidian vault to reach its core.',
          tiles: [
            { r: 4, c: 0, type: 'E', dir: 0, color: 'gold' },
            { r: 0, c: 0, type: 'M', initRot: 1, solRot: 0 },
            { r: 0, c: 2, type: 'T', color: 'gold' },
            { r: 0, c: 4, type: 'M', initRot: 0, solRot: 1 },
            { r: 4, c: 4, type: 'M', initRot: 1, solRot: 0 },
            { r: 4, c: 2, type: 'M', initRot: 0, solRot: 1 },
            { r: 2, c: 2, type: 'T', color: 'gold' },
            { r: 1, c: 1, type: 'W' }, { r: 1, c: 2, type: 'W' }, { r: 1, c: 3, type: 'W' },
            { r: 3, c: 1, type: 'W' }, { r: 3, c: 3, type: 'W' }
          ]
        },
        {
          id: 4, name: 'Twin Beams', size: 5,
          tip: 'Splitters let light pass straight through AND reflect 90° at the same time!',
          tiles: [
            { r: 2, c: 0, type: 'E', dir: 1, color: 'cyan' },
            { r: 2, c: 2, type: 'S', initRot: 1, solRot: 0 },
            { r: 0, c: 2, type: 'M', initRot: 1, solRot: 0 },
            { r: 0, c: 4, type: 'T', color: 'cyan' },
            { r: 2, c: 4, type: 'T', color: 'cyan' },
            { r: 1, c: 3, type: 'W' }
          ]
        },
        {
          id: 5, name: 'Prism Cross', size: 6,
          tip: 'Chain two splitters to light up three gems from a single laser.',
          tiles: [
            { r: 3, c: 0, type: 'E', dir: 1, color: 'cyan' },
            { r: 3, c: 2, type: 'S', initRot: 0, solRot: 1 },
            { r: 5, c: 2, type: 'M', initRot: 0, solRot: 1 },
            { r: 5, c: 5, type: 'T', color: 'cyan' },
            { r: 3, c: 4, type: 'S', initRot: 1, solRot: 0 },
            { r: 1, c: 4, type: 'T', color: 'cyan' },
            { r: 3, c: 5, type: 'T', color: 'cyan' },
            { r: 2, c: 2, type: 'W' }, { r: 4, c: 4, type: 'W' }
          ]
        },
        {
          id: 6, name: 'Crystal Diamond', size: 6,
          tip: 'Split the gold beam downward and left to reach all corners.',
          tiles: [
            { r: 0, c: 2, type: 'E', dir: 2, color: 'gold' },
            { r: 2, c: 2, type: 'S', initRot: 1, solRot: 0 },
            { r: 2, c: 0, type: 'M', initRot: 1, solRot: 0 },
            { r: 4, c: 0, type: 'T', color: 'gold' },
            { r: 5, c: 2, type: 'M', initRot: 0, solRot: 1 },
            { r: 5, c: 4, type: 'T', color: 'gold' },
            { r: 5, c: 5, type: 'M', initRot: 1, solRot: 0 },
            { r: 1, c: 5, type: 'T', color: 'gold' },
            { r: 3, c: 3, type: 'W' }, { r: 2, c: 4, type: 'W' }
          ]
        },
        {
          id: 7, name: 'Warp Gate', size: 6,
          tip: 'Portals warp lasers straight across solid walls while keeping their direction!',
          tiles: [
            { r: 1, c: 0, type: 'E', dir: 1, color: 'magenta' },
            { r: 1, c: 1, type: 'P', pair: 'A' },
            { r: 4, c: 3, type: 'P', pair: 'A' },
            { r: 4, c: 4, type: 'T', color: 'magenta' },
            { r: 4, c: 5, type: 'M', initRot: 1, solRot: 0 },
            { r: 1, c: 5, type: 'M', initRot: 0, solRot: 1 },
            { r: 1, c: 3, type: 'T', color: 'magenta' },
            { r: 0, c: 2, type: 'W' }, { r: 1, c: 2, type: 'W' }, { r: 2, c: 2, type: 'W' },
