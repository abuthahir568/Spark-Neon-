      };

      // Load saved stars safely
      try {
        const saved = localStorage.getItem('prism_spark_stars_v1');
        if (saved) state.starsEarned = JSON.parse(saved) || {};
      } catch (e) {}

      function saveStars() {
        try {
          localStorage.setItem('prism_spark_stars_v1', JSON.stringify(state.starsEarned));
        } catch (e) {}
      }

      const TOTAL_LEVELS = 1000;
      const PAGE_SIZE = 50;
      let levelsModalPage = 0;
      const levelCache = {};

      function mulberry32(seed) {
        let a = seed >>> 0;
        return function () {
          a |= 0;
          a = (a + 0x6D2B79F5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function simulateTiles(size, tiles, useSol) {
        const grid = Array.from({ length: size }, () => Array(size).fill(null));
        const portals = {};
        let targets = 0;
        const queue = [];
        for (let i = 0; i < tiles.length; i++) {
          const tc = Object.assign({}, tiles[i]);
          if (tc.type === 'M' || tc.type === 'S') tc.rot = useSol ? tc.solRot : tc.initRot;
          grid[tc.r][tc.c] = tc;
          if (tc.type === 'E') queue.push({ r: tc.r, c: tc.c, d: tc.dir, col: tc.color });
          else if (tc.type === 'P') (portals[tc.pair] = portals[tc.pair] || []).push(tc);
          else if (tc.type === 'T') targets++;
        }
        const lit = new Set();
        const visited = new Set();
        let safety = 0;
        while (queue.length > 0 && safety++ < 600) {
          const ray = queue.shift();
          const nr = ray.r + DR[ray.d];
          const nc = ray.c + DC[ray.d];
          if (nr < 0 || nr >= size || nc < 0 || nc >= size) continue;
          const k = `${nr},${nc},${ray.d},${ray.col}`;
          if (visited.has(k)) continue;
          visited.add(k);
          const tile = grid[nr][nc];
          if (!tile) {
            queue.push({ r: nr, c: nc, d: ray.d, col: ray.col });
          } else if (tile.type === 'W' || tile.type === 'E') {
            continue;
          } else if (tile.type === 'T') {
            if (tile.color === ray.col) lit.add(`${nr},${nc}`);
            queue.push({ r: nr, c: nc, d: ray.d, col: ray.col });
          } else if (tile.type === 'F') {
            queue.push({ r: nr, c: nc, d: ray.d, col: tile.color });
          } else if (tile.type === 'M') {
            const nd = (tile.rot % 2 === 0) ? (ray.d ^ 1) : (3 - ray.d);
            queue.push({ r: nr, c: nc, d: nd, col: ray.col });
          } else if (tile.type === 'S') {
            const nd = (tile.rot % 2 === 0) ? (ray.d ^ 1) : (3 - ray.d);
            queue.push({ r: nr, c: nc, d: ray.d, col: ray.col });
            queue.push({ r: nr, c: nc, d: nd, col: ray.col });
          } else if (tile.type === 'P') {
            const list = portals[tile.pair] || [];
            const other = list.find(p => p.r !== nr || p.c !== nc);
            if (other) queue.push({ r: other.r, c: other.c, d: ray.d, col: ray.col });
          }
        }
        return { lit: lit.size, targets };
      }

      function getSectorMeta(levelNum) {
        if (levelNum <= 100) return { sector: 'Neon Mirrors', size: levelNum <= 40 ? 5 : 6, turns: 4, allowSplit: false, allowPortal: false, allowFilter: false, tip: 'Bounce the laser around obsidian walls to light every crystal gem.' };
        if (levelNum <= 250) return { sector: 'Prism Splitters', size: 6, turns: 5, allowSplit: true, allowPortal: false, allowFilter: false, tip: 'Use splitters to branch one laser beam into multiple targets.' };
        if (levelNum <= 450) return { sector: 'Warp Portals', size: levelNum <= 350 ? 6 : 7, turns: 5, allowSplit: true, allowPortal: true, allowFilter: false, tip: 'Guide beams through warp portals to cross the grid in a flash.' };
        if (levelNum <= 700) return { sector: 'Chroma Filters', size: 7, turns: 6, allowSplit: true, allowPortal: true, allowFilter: true, tip: 'Color filters recolor beams — match every gem with its exact color!' };
        return { sector: 'Quantum Master', size: levelNum <= 850 ? 7 : 8, turns: 7, allowSplit: true, allowPortal: true, allowFilter: true, tip: 'Master circuit: combine mirrors, splitters, warp portals, and color filters!' };
      }

      function generateDeterministicLevel(levelNum) {
        const meta = getSectorMeta(levelNum);
        const size = meta.size;
        const colors = ['cyan', 'magenta', 'gold'];

        for (let attempt = 0; attempt < 80; attempt++) {
          const rng = mulberry32((levelNum * 2654435761 + attempt * 1013904223) >>> 0);
          const randInt = (n) => Math.floor(rng() * n);
          const grid = Array.from({ length: size }, () => Array(size).fill(null));
          const tiles = [];

          let curColor = colors[(levelNum + attempt) % colors.length];
          const edge = randInt(4);
          let er, ec, dir;
          if (edge === 0) { er = 0; ec = randInt(size); dir = 2; }
          else if (edge === 1) { er = randInt(size); ec = 0; dir = 1; }
          else if (edge === 2) { er = size - 1; ec = randInt(size); dir = 0; }
          else { er = randInt(size); ec = size - 1; dir = 3; }

          tiles.push({ r: er, c: ec, type: 'E', dir, color: curColor });
          grid[er][ec] = 'E';

          let r = er, c = ec;
          let mirrorsPlaced = 0;
          let portalPlaced = false;
          let filterPlaced = false;
          const segCells = []; // {r, c, color}

          for (let step = 0; step < meta.turns; step++) {
            const cands = [];
            let nr = r + DR[dir], nc = c + DC[dir];
            while (nr >= 0 && nr < size && nc >= 0 && nc < size) {
              if (grid[nr][nc] !== null) break;
              cands.push({ r: nr, c: nc });
              nr += DR[dir];
              nc += DC[dir];
            }
            if (cands.length === 0) break;

            const pickIdx = cands.length > 1 ? 1 + randInt(cands.length - 1) : 0;
            const pick = cands[pickIdx];
            for (let i = 0; i < pickIdx; i++) {
              segCells.push({ r: cands[i].r, c: cands[i].c, color: curColor });
            }

            if (step === meta.turns - 1) {
              tiles.push({ r: pick.r, c: pick.c, type: 'T', color: curColor });
              grid[pick.r][pick.c] = 'T';
              break;
            }

            // Optionally place a linked Portal pair mid-path
            if (meta.allowPortal && !portalPlaced && step >= 1 && step <= meta.turns - 3 && rng() < 0.45) {
              const empties = [];
              for (let pr = 1; pr < size - 1; pr++) {
                for (let pc = 1; pc < size - 1; pc++) {
                  if (!grid[pr][pc] && (pr !== pick.r || pc !== pick.c)) {
                    const tr = pr + DR[dir], tc = pc + DC[dir];
                    if (tr >= 0 && tr < size && tc >= 0 && tc < size && !grid[tr][tc]) {
                      empties.push({ r: pr, c: pc });
                    }
                  }
                }
              }
              if (empties.length > 0) {
                const exitP = empties[randInt(empties.length)];
                tiles.push({ r: pick.r, c: pick.c, type: 'P', pair: 'A' });
                tiles.push({ r: exitP.r, c: exitP.c, type: 'P', pair: 'A' });
                grid[pick.r][pick.c] = 'P';
                grid[exitP.r][exitP.c] = 'P';
                r = exitP.r; c = exitP.c;
                portalPlaced = true;
                continue;
              }
            }

            // Optionally place a Color Filter on an intermediate cell before turning
            if (meta.allowFilter && !filterPlaced && pickIdx >= 1 && rng() < 0.55) {
              const fcCell = cands[0];
              if (!grid[fcCell.r][fcCell.c]) {
                const nextColor = colors[(colors.indexOf(curColor) + 1 + randInt(2)) % colors.length];
                tiles.push({ r: fcCell.r, c: fcCell.c, type: 'F', color: nextColor });
                grid[fcCell.r][fcCell.c] = 'F';
                curColor = nextColor;
                filterPlaced = true;
              }
            }

            // Turn with Mirror or Splitter
            const rots = rng() < 0.5 ? [0, 1] : [1, 0];
            let turned = false;
            for (let ri = 0; ri < rots.length; ri++) {
              const solRot = rots[ri];
              const ndir = solRot === 0 ? (dir ^ 1) : (3 - dir);
              const tr = pick.r + DR[ndir], tc = pick.c + DC[ndir];
              if (tr >= 0 && tr < size && tc >= 0 && tc < size && grid[tr][tc] === null) {
                const isSplit = meta.allowSplit && mirrorsPlaced >= 1 && mirrorsPlaced <= 2 && rng() < 0.45;
                tiles.push({
                  r: pick.r, c: pick.c,
                  type: isSplit ? 'S' : 'M',
                  initRot: 1 - solRot,
                  solRot
                });
                grid[pick.r][pick.c] = 'M';
                // If splitter, optionally put a bonus target straight ahead
                if (isSplit) {
                  let sr = pick.r + DR[dir], sc = pick.c + DC[dir];
                  let straightCands = [];
                  while (sr >= 0 && sr < size && sc >= 0 && sc < size && !grid[sr][sc]) {
                    straightCands.push({ r: sr, c: sc });
                    sr += DR[dir]; sc += DC[dir];
                  }
                  if (straightCands.length > 0) {
                    const st = straightCands[straightCands.length - 1];
                    tiles.push({ r: st.r, c: st.c, type: 'T', color: curColor });
                    grid[st.r][st.c] = 'T';
                  }
                }
                r = pick.r; c = pick.c; dir = ndir;
                mirrorsPlaced++;
                turned = true;
                break;
              }
            }
            if (!turned) {
              tiles.push({ r: pick.r, c: pick.c, type: 'T', color: curColor });
              grid[pick.r][pick.c] = 'T';
              break;
            }
          }

          // Place 1-2 extra gems along path segments
          let extraGems = 0;
          for (let i = segCells.length - 1; i >= 0 && extraGems < 2; i--) {
            const sc = segCells[i];
            if (!grid[sc.r][sc.c] && rng() < 0.35) {
              tiles.push({ r: sc.r, c: sc.c, type: 'T', color: sc.color });
              grid[sc.r][sc.c] = 'T';
              extraGems++;
            }
          }

          // Add decorative obsidian walls in unused cells
          const pathOcc = new Set(segCells.map(p => `${p.r},${p.c}`));
          const wallTarget = Math.min(6, 2 + Math.floor(size / 2));
          let walls = 0;
          for (let w = 0; w < 24 && walls < wallTarget; w++) {
            const wr = randInt(size), wc = randInt(size);
            if (!grid[wr][wc] && !pathOcc.has(`${wr},${wc}`)) {
              grid[wr][wc] = 'W';
              tiles.push({ r: wr, c: wc, type: 'W' });
              walls++;
            }
          }

          if (mirrorsPlaced >= 3) {
            const solSim = simulateTiles(size, tiles, true);
            const initSim = simulateTiles(size, tiles, false);
            if (solSim.targets >= 1 && solSim.lit === solSim.targets && initSim.lit < solSim.targets) {
              return {
                id: levelNum,
                name: `${meta.sector}`,
                size,
                tip: meta.tip,
                tiles
              };
            }
          }
        }
        // Guaranteed fallback (cloned handcrafted level with levelNum id)
        const fb = LEVELS[(levelNum - 1) % LEVELS.length];
        return {
          id: levelNum,
          name: `${meta.sector}`,
          size: fb.size,
          tip: meta.tip,
          tiles: fb.tiles.map(t => Object.assign({}, t))
        };
      }

      function getCampaignLevel(indexZeroBased) {
        if (indexZeroBased < LEVELS.length) return LEVELS[indexZeroBased];
        const levelNum = indexZeroBased + 1;
        if (!levelCache[levelNum]) {
          levelCache[levelNum] = generateDeterministicLevel(levelNum);
        }
        return levelCache[levelNum];
      }

      // --- Endless Random Solvable Puzzle Generator ---
      function generateEndlessLevel(seedNum) {
        const size = 6;
        const colors = ['cyan', 'magenta', 'gold'];
        const mainColor = colors[seedNum % colors.length];

        for (let attempt = 0; attempt < 40; attempt++) {
          const grid = Array.from({ length: size }, () => Array(size).fill(null));
          // Pick emitter on left or top edge
          const fromLeft = Math.random() < 0.5;
          const er = fromLeft ? Math.floor(Math.random() * size) : 0;
          const ec = fromLeft ? 0 : Math.floor(Math.random() * size);
          let dir = fromLeft ? 1 : 2;
          const tiles = [{ r: er, c: ec, type: 'E', dir, color: mainColor }];
          grid[er][ec] = 'E';

          let r = er, c = ec;
          let mirrorsPlaced = 0;
          const targetCount = 4 + (seedNum % 2); // 4 or 5 turns
          let pathCells = [];

          for (let step = 0; step < targetCount; step++) {
            // Walk 1..4 cells in current dir
            const candidates = [];
            let nr = r + DR[dir], nc = c + DC[dir];
            while (nr >= 0 && nr < size && nc >= 0 && nc < size) {
              if (grid[nr][nc] !== null) break;
              candidates.push({ r: nr, c: nc });
              nr += DR[dir];
              nc += DC[dir];
            }
            if (candidates.length === 0) break;
            // Prefer cells not right next to current if possible
            const pickIdx = candidates.length > 1
              ? 1 + Math.floor(Math.random() * (candidates.length - 1))
              : 0;
            const pick = candidates[pickIdx];

            // Record intermediate cells for possible gems
            for (let i = 0; i < pickIdx; i++) {
              pathCells.push(candidates[i]);
            }

            if (step === targetCount - 1) {
              // Place final target
              tiles.push({ r: pick.r, c: pick.c, type: 'T', color: mainColor });
              grid[pick.r][pick.c] = 'T';
              break;
            }

            // Try turning left or right
            const possibleRots = [0, 1].sort(() => Math.random() - 0.5);
            let turned = false;
            for (const solRot of possibleRots) {
              const ndir = solRot === 0 ? (dir ^ 1) : (3 - dir);
              const tr = pick.r + DR[ndir], tc = pick.c + DC[ndir];
              if (tr >= 0 && tr < size && tc >= 0 && tc < size && grid[tr][tc] === null) {
                const isSplitter = (mirrorsPlaced === 1 && Math.random() < 0.5);
                tiles.push({
                  r: pick.r, c: pick.c,
                  type: isSplitter ? 'S' : 'M',
                  initRot: 1 - solRot,
                  solRot
                });
                grid[pick.r][pick.c] = 'M';
                r = pick.r; c = pick.c; dir = ndir;
                mirrorsPlaced++;
                turned = true;
                break;
              }
            }
            if (!turned) {
              tiles.push({ r: pick.r, c: pick.c, type: 'T', color: mainColor });
              grid[pick.r][pick.c] = 'T';
              break;
            }
          }

          // Add 1 extra gem along the path if available
          if (pathCells.length > 0) {
            const extra = pathCells[Math.floor(Math.random() * pathCells.length)];
            if (!grid[extra.r][extra.c]) {
              tiles.push({ r: extra.r, c: extra.c, type: 'T', color: mainColor });
              grid[extra.r][extra.c] = 'T';
            }
          }

          // Add 2-3 decorative walls in empty cells not on path
          const pathSet = new Set(pathCells.map(p => `${p.r},${p.c}`));
          let walls = 0;
          for (let w = 0; w < 15 && walls < 3; w++) {
            const wr = Math.floor(Math.random() * size);
            const wc = Math.floor(Math.random() * size);
            if (!grid[wr][wc] && !pathSet.has(`${wr},${wc}`)) {
              grid[wr][wc] = 'W';
              tiles.push({ r: wr, c: wc, type: 'W' });
              walls++;
            }
          }

          const hasTarget = tiles.some(t => t.type === 'T');
          if (hasTarget && mirrorsPlaced >= 3) {
            return {
              id: 100 + seedNum,
              name: `Endless #${seedNum}`,
              size,
              tip: 'Procedurally generated circuit — rotate mirrors to light every gem!',
              tiles
            };
          }
        }
        // Fallback to level 5
        return LEVELS[4];
      }

      // --- Load Level ---
      function loadLevel(levelObj, mode = 'campaign') {
        state.mode = mode;
        state.size = levelObj.size;
        state.name = levelObj.name;
        state.tip = levelObj.tip;
        state.moves = 0;
        state.undoStack = [];
        state.won = false;
        state.hintTile = null;
        state.hintTimer = 0;
        state.particles = [];
        state.cursor = null;

        state.grid = Array.from({ length: state.size }, () => Array(state.size).fill(null));
        state.rotatables = [];
        state.totalTargets = 0;

        let parCalc = 0;
        levelObj.tiles.forEach(t => {
          const tile = Object.assign({}, t);
          if (tile.type === 'M' || tile.type === 'S') {
            tile.rot = tile.initRot;
            tile.visualAngle = tile.rot * (Math.PI / 2);
            tile.targetAngle = tile.visualAngle;
            state.rotatables.push(tile);
            if (tile.initRot % 2 !== tile.solRot % 2) parCalc++;
          }
          if (tile.type === 'T') state.totalTargets++;
          state.grid[tile.r][tile.c] = tile;
        });

        state.par = Math.max(1, parCalc);
        computeBeams(false);
        updateHUD();
        hideModals();
        showToast(mode === 'endless' ? `${levelObj.name}` : `Level ${levelObj.id}: ${levelObj.name}`);
      }

      // --- Raytracing Engine ---
      function computeBeams(triggerEffects = true) {
        const prevLit = new Set(state.litTargets);
        const beams = [];
        const litTargets = new Set();
        const visited = new Set();
        const queue = [];

        // Find portals map
        const portals = {};
        for (let r = 0; r < state.size; r++) {
          for (let c = 0; c < state.size; c++) {
            const tile = state.grid[r][c];
            if (!tile) continue;
            if (tile.type === 'E') {
              queue.push({ r, c, dir: tile.dir, color: tile.color, isStart: true });
            } else if (tile.type === 'P') {
              if (!portals[tile.pair]) portals[tile.pair] = [];
              portals[tile.pair].push(tile);
            }
          }
        }

        let safety = 0;
        while (queue.length > 0 && safety++ < 600) {
          const ray = queue.shift();
          let { r, c, dir, color, isStart } = ray;
          const startR = r, startC = c;

          const nr = r + DR[dir];
          const nc = c + DC[dir];

          // If exiting board
          if (nr < 0 || nr >= state.size || nc < 0 || nc >= state.size) {
            beams.push({
              r1: startR, c1: startC,
              r2: startR + DR[dir] * 0.48,
              c2: startC + DC[dir] * 0.48,
              color
            });
            continue;
          }

          const visitKey = `${nr},${nc},${dir},${color}`;
          if (visited.has(visitKey)) {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            continue;
          }
          visited.add(visitKey);

          const tile = state.grid[nr][nc];

          if (!tile) {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            queue.push({ r: nr, c: nc, dir, color });
          } else if (tile.type === 'W' || tile.type === 'E') {
            beams.push({
              r1: startR, c1: startC,
              r2: nr - DR[dir] * 0.36,
              c2: nc - DC[dir] * 0.36,
              color
            });
          } else if (tile.type === 'T') {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            if (tile.color === color) {
              litTargets.add(`${nr},${nc}`);
            }
            queue.push({ r: nr, c: nc, dir, color });
          } else if (tile.type === 'F') {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            queue.push({ r: nr, c: nc, dir, color: tile.color });
          } else if (tile.type === 'M') {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            const ndir = (tile.rot % 2 === 0) ? (dir ^ 1) : (3 - dir);
            queue.push({ r: nr, c: nc, dir: ndir, color });
          } else if (tile.type === 'S') {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            // Pass straight through AND reflect 90 degrees
            const ndir = (tile.rot % 2 === 0) ? (dir ^ 1) : (3 - dir);
            queue.push({ r: nr, c: nc, dir, color });
            queue.push({ r: nr, c: nc, dir: ndir, color });
          } else if (tile.type === 'P') {
            beams.push({ r1: startR, c1: startC, r2: nr, c2: nc, color });
            const pairList = portals[tile.pair] || [];
            const other = pairList.find(p => p.r !== nr || p.c !== nc);
            if (other) {
              queue.push({ r: other.r, c: other.c, dir, color });
            }
          }
        }

        state.beams = beams;
        state.litTargets = litTargets;

        // Spawn sparkles on newly lit gems
        if (triggerEffects) {
          let newlyLit = false;
          litTargets.forEach(key => {
            if (!prevLit.has(key)) {
              newlyLit = true;
              const [tr, tc] = key.split(',').map(Number);
              const tile = state.grid[tr][tc];
              spawnParticles(tr, tc, COLORS[tile.color].main, 16);
            }
          });
          if (newlyLit) sfxGemLit();
        }

        // Check win
        if (!state.won && state.totalTargets > 0 && litTargets.size === state.totalTargets) {
          state.won = true;
          handleVictory();
        }
      }

      function handleVictory() {
        sfxWin();
        // Big celebration burst on all targets
        state.litTargets.forEach(key => {
          const [tr, tc] = key.split(',').map(Number);
          const tile = state.grid[tr][tc];
          spawnParticles(tr, tc, COLORS[tile.color].main, 28);
        });

        const stars = state.moves <= state.par ? 3 : (state.moves <= state.par + 3 ? 2 : 1);
        if (state.mode === 'campaign') {
          const lvlId = getCampaignLevel(state.levelIndex).id;
          state.starsEarned[lvlId] = Math.max(state.starsEarned[lvlId] || 0, stars);
          saveStars();
        }
        updateHUD();

        setTimeout(() => {
          if (!state.won) return;
          const winTitle = document.getElementById('winTitle');
          const winStars = document.getElementById('winStars');
          const winStats = document.getElementById('winStats');
          const btnNext = document.getElementById('btnWinNext');

          winTitle.textContent = state.mode === 'endless'
            ? `${state.name} Cleared!`
            : `Level ${getCampaignLevel(state.levelIndex).id} Cleared!`;
          winStars.textContent = '★'.repeat(stars) + '☆'.repeat(3 - stars);
          winStats.textContent = `Solved in ${state.moves} move${state.moves === 1 ? '' : 's'} (Par ${state.par})`;

          if (state.mode === 'endless') {
            btnNext.textContent = 'Next Endless →';
          } else if (state.levelIndex < TOTAL_LEVELS - 1) {
            btnNext.textContent = 'Next Level →';
          } else {
            btnNext.textContent = 'Try Endless Mode →';
          }
          document.getElementById('winModal').classList.remove('hidden');
        }, 480);
      }

      function rotateTile(r, c, recordUndo = true) {
        if (state.won) return;
        const tile = state.grid[r] && state.grid[r][c];
        if (!tile || (tile.type !== 'M' && tile.type !== 'S')) return;

        ensureAudio();
        tile.rot = (tile.rot + 1) % 2;
        tile.targetAngle += Math.PI / 2;
        if (recordUndo) {
          state.undoStack.push({ r, c });
          state.moves++;
        }
        if (state.hintTile && state.hintTile.r === r && state.hintTile.c === c) {
          state.hintTile = null;
        }
        sfxRotate();
        spawnParticles(r, c, '#38bdf8', 7);
        computeBeams(true);
        updateHUD();
      }

      // --- Particles ---
      function spawnParticles(r, c, color, count) {
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 0.6 + Math.random() * 2.2;
          state.particles.push({
            r: r + 0.5,
            c: c + 0.5,
            vr: Math.sin(angle) * speed * 0.04,
            vc: Math.cos(angle) * speed * 0.04,
            life: 1.0,
            decay: 0.025 + Math.random() * 0.025,
            size: 2 + Math.random() * 3,
            color
          });
        }
      }

      // --- UI Helpers ---
      let toastTimeout = null;
      function showToast(msg) {
        const el = document.getElementById('toastMsg');
        el.textContent = msg;
        el.classList.remove('opacity-0');
        el.classList.add('opacity-100');
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          el.classList.remove('opacity-100');
          el.classList.add('opacity-0');
        }, 2100);
      }

      function hideModals() {
        document.getElementById('winModal').classList.add('hidden');
        document.getElementById('levelsModal').classList.add('hidden');
        document.getElementById('helpModal').classList.add('hidden');
      }

      function updateHUD() {
        const sub = state.mode === 'endless'
          ? `${state.name} • Random`
          : `Level ${getCampaignLevel(state.levelIndex).id} / ${TOTAL_LEVELS} • ${state.name}`;
        document.getElementById('levelSubtitle').textContent = sub;
        document.getElementById('movesDisplay').textContent = String(state.moves);
        document.getElementById('parDisplay').textContent = `/ ${state.par} par`;
        document.getElementById('gemsDisplay').textContent = `${state.litTargets.size} / ${state.totalTargets}`;
        document.getElementById('tipLine').textContent = state.tip;
        document.getElementById('btnUndo').disabled = state.undoStack.length === 0 || state.won;

        // Live star preview
        const stars = state.moves <= state.par ? 3 : (state.moves <= state.par + 3 ? 2 : 1);
        const sp = document.getElementById('starPreview');
        sp.innerHTML = '';
        for (let i = 0; i < 3; i++) {
          const span = document.createElement('span');
          span.textContent = i < stars ? '★' : '☆';
          span.className = i < stars ? 'text-amber-400 text-base' : 'text-slate-600 text-base';
          sp.appendChild(span);
        }

        const totalStars = Object.values(state.starsEarned).reduce((a, b) => a + b, 0);
        document.getElementById('totalStarsBadge').textContent = `★ ${totalStars}`;
      }

      function renderLevelsModal() {
        const totalPages = Math.ceil(TOTAL_LEVELS / PAGE_SIZE);
        levelsModalPage = Math.max(0, Math.min(totalPages - 1, levelsModalPage));
        const startIdx = levelsModalPage * PAGE_SIZE;
        const endIdx = Math.min(TOTAL_LEVELS, startIdx + PAGE_SIZE);

        const totalStars = Object.values(state.starsEarned).reduce((a, b) => a + b, 0);
        const clearedCount = Object.keys(state.starsEarned).length;
        document.getElementById('levelsProgressText').textContent =
          `${TOTAL_LEVELS.toLocaleString()} levels • ${clearedCount} cleared • ★ ${totalStars}`;
        document.getElementById('levelsPageLabel').textContent =
          `Levels ${startIdx + 1} – ${endIdx}`;
        document.getElementById('btnPagePrev').disabled = levelsModalPage === 0;
        document.getElementById('btnPageNext').disabled = levelsModalPage === totalPages - 1;

        const grid = document.getElementById('levelsGrid');
        grid.innerHTML = '';
        for (let idx = startIdx; idx < endIdx; idx++) {
          const lvlId = idx + 1;
          const stars = state.starsEarned[lvlId] || 0;
          const isCurrent = state.mode === 'campaign' && state.levelIndex === idx;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `btn-tap rounded-xl py-2 px-1 text-center border transition ${
            isCurrent
              ? 'bg-cyan-500/25 border-cyan-400 text-white'
              : stars > 0
                ? 'bg-emerald-950/40 border-emerald-500/40 text-slate-100 hover:border-cyan-400/60'
                : 'bg-slate-900/70 border-slate-700/70 text-slate-200 hover:border-cyan-500/50'
          }`;
          btn.innerHTML = `
            <div class="font-display font-bold text-xs">${lvlId}</div>
            <div class="text-[9px] leading-none mt-1 ${stars > 0 ? 'text-amber-400' : 'text-slate-600'}">${'★'.repeat(stars)}${'☆'.repeat(3 - stars)}</div>
          `;
          btn.addEventListener('click', () => {
            state.levelIndex = idx;
            loadLevel(getCampaignLevel(idx), 'campaign');
          });
          grid.appendChild(btn);
        }
      }

      // --- Canvas Rendering ---
      const canvas = document.getElementById('gameCanvas');
      const ctx = canvas.getContext('2d');
      let boardPx = 360;
      let dpr = 1;

      function resizeCanvas() {
        const wrap = document.getElementById('board-wrap');
        const rect = wrap.getBoundingClientRect();
        boardPx = Math.max(240, Math.floor(rect.width));
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.floor(boardPx * dpr);
        canvas.height = Math.floor(boardPx * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      function drawRoundedRect(x, y, w, h, rad) {
        ctx.beginPath();
        ctx.moveTo(x + rad, y);
        ctx.lineTo(x + w - rad, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
        ctx.lineTo(x + w, y + h - rad);
        ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
        ctx.lineTo(x + rad, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
        ctx.lineTo(x, y + rad);
        ctx.quadraticCurveTo(x, y, x + rad, y);
        ctx.closePath();
      }

      function render(ts) {
        state.animTime = ts * 0.001;
        const pad = 12;
        const inner = boardPx - pad * 2;
        const cell = inner / state.size;

        // Background
        ctx.fillStyle = '#090f22';
        ctx.fillRect(0, 0, boardPx, boardPx);

        // Subtle grid cells
        for (let r = 0; r < state.size; r++) {
          for (let c = 0; c < state.size; c++) {
            const x = pad + c * cell;
            const y = pad + r * cell;
            drawRoundedRect(x + 2, y + 2, cell - 4, cell - 4, 8);
            ctx.fillStyle = (r + c) % 2 === 0 ? 'rgba(30, 41, 59, 0.42)' : 'rgba(15, 23, 42, 0.55)';
            ctx.fill();
            ctx.strokeStyle = 'rgba(71, 85, 105, 0.22)';
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }

        // Keyboard focus cursor
        if (state.cursor) {
          const cx = pad + state.cursor.c * cell;
          const cy = pad + state.cursor.r * cell;
          drawRoundedRect(cx + 3, cy + 3, cell - 6, cell - 6, 8);
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.85)';
          ctx.lineWidth = 2;
          ctx.stroke();
        }

        // Hint pulse highlight
        if (state.hintTile) {
          const hx = pad + (state.hintTile.c + 0.5) * cell;
          const hy = pad + (state.hintTile.r + 0.5) * cell;
          const pulse = 0.5 + 0.5 * Math.sin(state.animTime * 7);
          ctx.beginPath();
          ctx.arc(hx, hy, cell * (0.38 + pulse * 0.08), 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(251, 191, 36, ${0.45 + pulse * 0.55})`;
          ctx.lineWidth = 3;
          ctx.stroke();
        }

        // Draw Laser Beams (layered glow + animated energy dashes)
        ctx.save();
        ctx.lineCap = 'round';
        state.beams.forEach(b => {
          const x1 = pad + (b.c1 + 0.5) * cell;
          const y1 = pad + (b.r1 + 0.5) * cell;
          const x2 = pad + (b.c2 + 0.5) * cell;
          const y2 = pad + (b.r2 + 0.5) * cell;
          const col = COLORS[b.color] || COLORS.cyan;

          // Outer glow
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = col.glow;
          ctx.lineWidth = Math.max(8, cell * 0.2);
          ctx.stroke();

          // Mid beam
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = col.main;
          ctx.lineWidth = Math.max(3.2, cell * 0.08);
          ctx.stroke();

          // White core
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = Math.max(1.4, cell * 0.032);
          ctx.stroke();

          // Moving photon pulse
          ctx.save();
          ctx.setLineDash([4, 14]);
          ctx.lineDashOffset = -state.animTime * 48;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.strokeStyle = col.soft;
          ctx.lineWidth = 2.5;
          ctx.stroke();
          ctx.restore();
        });
        ctx.restore();

        // Draw Tiles
        for (let r = 0; r < state.size; r++) {
          for (let c = 0; c < state.size; c++) {
            const tile = state.grid[r][c];
            if (!tile) continue;
            const cx = pad + (c + 0.5) * cell;
            const cy = pad + (r + 0.5) * cell;

            if (tile.type === 'W') {
              // Obsidian beveled wall
              const s = cell * 0.78;
              drawRoundedRect(cx - s / 2, cy - s / 2, s, s, 8);
              const g = ctx.createLinearGradient(cx - s / 2, cy - s / 2, cx + s / 2, cy + s / 2);
              g.addColorStop(0, '#334155');
              g.addColorStop(1, '#0f172a');
              ctx.fillStyle = g;
              ctx.fill();
              ctx.strokeStyle = '#475569';
              ctx.lineWidth = 1.5;
              ctx.stroke();
              // Subtle X bevel
              ctx.beginPath();
              ctx.moveTo(cx - s * 0.22, cy - s * 0.22);
              ctx.lineTo(cx + s * 0.22, cy + s * 0.22);
              ctx.moveTo(cx + s * 0.22, cy - s * 0.22);
              ctx.lineTo(cx - s * 0.22, cy + s * 0.22);
              ctx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
              ctx.lineWidth = 1.5;
              ctx.stroke();
            } else if (tile.type === 'E') {
              // Laser Emitter
              const col = COLORS[tile.color];
              ctx.save();
              ctx.translate(cx, cy);
              const rotMap = [ -Math.PI / 2, 0, Math.PI / 2, Math.PI ];
              ctx.rotate(rotMap[tile.dir]);

              // Base housing
              drawRoundedRect(-cell * 0.34, -cell * 0.3, cell * 0.62, cell * 0.6, 8);
              ctx.fillStyle = '#1e293b';
              ctx.fill();
              ctx.strokeStyle = col.main;
              ctx.lineWidth = 2;
              ctx.stroke();

              // Nozzle
              ctx.fillStyle = col.main;
              ctx.beginPath();
              ctx.moveTo(cell * 0.26, -cell * 0.14);
              ctx.lineTo(cell * 0.42, 0);
              ctx.lineTo(cell * 0.26, cell * 0.14);
              ctx.closePath();
              ctx.fill();

              // Core glow dot
              ctx.beginPath();
              ctx.arc(-cell * 0.04, 0, cell * 0.13, 0, Math.PI * 2);
              ctx.fillStyle = '#ffffff';
              ctx.shadowColor = col.main;
              ctx.shadowBlur = 12;
              ctx.fill();
              ctx.restore();
            } else if (tile.type === 'T') {
              // Crystal Target Gem
              const col = COLORS[tile.color];
              const isLit = state.litTargets.has(`${r},${c}`);
              const pulse = isLit ? (1 + 0.08 * Math.sin(state.animTime * 6)) : 1;
              const rad = cell * 0.28 * pulse;

              ctx.save();
              ctx.translate(cx, cy);
              if (isLit) {
                ctx.shadowColor = col.main;
                ctx.shadowBlur = 18;
              }
              ctx.beginPath();
              ctx.moveTo(0, -rad);
              ctx.lineTo(rad * 0.85, 0);
              ctx.lineTo(0, rad);
              ctx.lineTo(-rad * 0.85, 0);
              ctx.closePath();
              ctx.fillStyle = isLit ? col.main : 'rgba(15, 23, 42, 0.85)';
              ctx.fill();
              ctx.strokeStyle = col.main;
              ctx.lineWidth = isLit ? 2.5 : 2;
              ctx.stroke();

              // Inner facet
              ctx.beginPath();
              ctx.moveTo(0, -rad * 0.45);
              ctx.lineTo(rad * 0.38, 0);
              ctx.lineTo(0, rad * 0.45);
              ctx.lineTo(-rad * 0.38, 0);
              ctx.closePath();
              ctx.fillStyle = isLit ? '#ffffff' : col.glow;
              ctx.fill();
              ctx.restore();
            } else if (tile.type === 'M' || tile.type === 'S') {
              // Smoothly interpolate rotation
              tile.visualAngle += (tile.targetAngle - tile.visualAngle) * 0.24;
              const isSplitter = tile.type === 'S';

              ctx.save();
              ctx.translate(cx, cy);

              // Subtle interactive pad
              ctx.beginPath();
              ctx.arc(0, 0, cell * 0.36, 0, Math.PI * 2);
              ctx.fillStyle = isSplitter ? 'rgba(245, 158, 11, 0.12)' : 'rgba(56, 189, 248, 0.10)';
              ctx.fill();
              ctx.strokeStyle = isSplitter ? 'rgba(251, 191, 36, 0.35)' : 'rgba(56, 189, 248, 0.32)';
              ctx.lineWidth = 1.2;
              ctx.stroke();

              // Rotate bar: rot=0 -> '/' (-45deg), rot=1 -> '\' (+45deg)
              ctx.rotate(-Math.PI / 4 + tile.visualAngle);

              const len = cell * 0.62;
              const thick = isSplitter ? Math.max(5, cell * 0.11) : Math.max(6